{"nodes": [{"id": "claude_skills_frontend_design_skill_frontend_design_skill", "label": "Frontend Design Skill (.claude copy)", "file_type": "concept", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_frontend_design_skill_hero_as_thesis", "label": "Hero as Thesis principle", "file_type": "rationale", "rationale": "Open with the most characteristic thing in the subject's world (headline, image, animation, demo) as a deliberate choice rather than a generic big-number-plus-gradient template.", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_frontend_design_skill_typography_carries_personality", "label": "Typography Carries Personality principle", "file_type": "rationale", "rationale": "Pair display and body faces deliberately per-project rather than reusing the same families every time, so type itself becomes a memorable part of the design.", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_frontend_design_skill_structure_is_information", "label": "Structure Is Information principle", "file_type": "rationale", "rationale": "Structural devices (numbering, eyebrows, dividers) should encode something true about the content, not decorate it - e.g. numbered markers only when content is truly sequential.", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_frontend_design_skill_restraint_and_self_critique", "label": "Restraint and Self-Critique principle", "file_type": "rationale", "rationale": "Spend boldness in one signature element, keep everything else quiet, cut decoration that doesn't serve the brief, and build to a quality floor (responsive, keyboard focus, reduced motion) without announcing it.", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_frontend_design_skill_writing_in_design", "label": "Writing in Design guidance", "file_type": "rationale", "rationale": "Copy is design material: write from the end user's side of the screen, use active voice, keep vocabulary consistent through a flow, and treat errors/empty states as moments for direction not mood.", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_hero_as_thesis", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_typography_carries_personality", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_structure_is_information", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_restraint_and_self_critique", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_writing_in_design", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_frontend_design_skill_frontend_design_skill", "target": "claude_skills_frontend_design_skill_frontend_design_skill", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}